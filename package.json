{
	"name": "serene-pub",
	"private": true,
	"version": "0.6.0-pr-1",
	"type": "module",
	"license": "AGPL-3.0",
	"bin": "build/index.js",
	"description": "Serene Pub is a modern, customizable chat application designed for immersive roleplay and creative conversations.",
	"author": {
		"name": "Jody Doolittle",
		"email": "jody@doolittle.me",
		"url": "https://github.com/doolijb"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/doolijb/serene-pub.git"
	},
	"homepage": "https://serenepub.com",
	"bugs": {
		"url": "https://github.com/doolijb/serene-pub/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && node scripts/customize-build.js",
		"start": "node build/index.js",
		"preview": "vite preview",
		"prepare": "npm run sdk:build && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:gate": "tsx scripts/c7Gate/gate.ts",
		"test:budgets": "svelte-kit sync && vitest run --config vitest.budgets.config.ts",
		"test:watch": "svelte-kit sync && vitest",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"comments:ratchet": "node scripts/comments-ratchet.js",
		"db:generate": "node scripts/check-db-lock.js drizzle-kit generate --config ./src/lib/server/db/drizzle.config.ts",
		"db:migrate": "node scripts/check-db-lock.js drizzle-kit migrate --config ./src/lib/server/db/drizzle.config.ts",
		"db:studio": "node scripts/check-db-lock.js drizzle-kit studio --config ./src/lib/server/db/drizzle.config.ts",
		"db:recover": "node scripts/check-db-lock.js node scripts/db-recover.js",
		"bundle": "node scripts/bundle-dist.js",
		"dist": "npm run build && npm run bundle",
		"create-executables": "node scripts/create-executables.js",
		"android:prepare": "node scripts/build-android.js",
		"android:build": "cd android && ./gradlew assembleRelease",
		"android:build:debug": "cd android && ./gradlew assembleDebug",
		"android:full": "npm run build && npm install --omit=dev && npm rebuild && npm run android:prepare && npm run android:build && npm install",
		"sdk:build": "npm run build --prefix ../serene-pub-sdk",
		"sdk:test": "npm test --prefix ../serene-pub-sdk/sdk-tests",
		"pipeline:ab": "node scripts/prompt-ab.js",
		"plugin:install": "node scripts/check-db-lock.js node scripts/plugin-install.js",
		"docs:build": "node scripts/build-docs.js",
		"docs:site": "node scripts/build-docs.js --site"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.0.0",
		"@fontsource/funnel-display": "^5.3.0",
		"@fontsource/funnel-sans": "^5.3.0",
		"@fontsource/literata": "^5.3.0",
		"@serene-pub/conformance": "file:../serene-pub-sdk/conformance",
		"@serene-pub/docs": "file:../serene-pub-sdk/docs",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.22.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/diff": "^7.0.2",
		"@types/lodash": "^4.17.17",
		"@types/node": "^20",
		"@types/pg": "^8.15.4",
