		"@replit/codemirror-lang-svelte": "^6.0.0",
		"@serene-pub/cli": "file:../serene-pub-sdk/cli",
		"@serene-pub/component-client": "file:../serene-pub-sdk/component-client",
		"@serene-pub/contracts": "file:../serene-pub-sdk/contracts",
