		"@types/png-chunks-encode": "^1.0.2",
		"@types/png-chunks-extract": "^1.0.2",
		"@types/pngjs": "^6.0.5",
		"axe-core": "^4.12.1",
		"axios": "^1.9.0",
		"drizzle-kit": "^0.30.6",
		"happy-dom": "^20.14.5",
		"pg": "^8.16.3",
