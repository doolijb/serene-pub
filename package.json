		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.20.3",
		"typescript": "^5.0.0",
		"vite": "^6.2.6",
